# ScanMaster deployment configuration. Copy to .env; process/CI variables override this file.
# Paths are relative to the working directory unless absolute.
SCANMASTER_DATABASE_PATH=.scanmaster/scanmaster.db          # optional; filesystem path
SCANMASTER_ARTIFACT_PATH=.scanmaster/artifacts              # optional; writable directory
SCANMASTER_LOG_LEVEL=INFO                                   # optional; DEBUG|INFO|WARNING|ERROR|CRITICAL
SCANMASTER_POLLING_INTERVAL_SECONDS=2                       # optional; >0 and <=300
SCANMASTER_EXECUTION_TIMEOUT_SECONDS=3600                   # optional; 1..86400
SCANMASTER_RETENTION_DAYS=30                                # optional; 1..3650
SCANMASTER_TLS_VERIFY_DEFAULT=true                          # optional; true|false (true strongly recommended)

# OWASP ZAP (plan directory must be the same mounted path visible to ZAP)
SCANMASTER_ZAP_ENABLED=false                                # optional; true|false
SCANMASTER_ZAP_URL=http://127.0.0.1:8080                    # optional; http(s) URL
SCANMASTER_ZAP_API_KEY=replace-with-zap-api-key             # optional; secret string
SCANMASTER_ZAP_PLAN_HOST_DIRECTORY=.scanmaster/zap-plans    # optional; host side of plan bind mount
SCANMASTER_ZAP_PLAN_CONTAINER_DIRECTORY=/zap/wrk            # optional; matching path visible inside ZAP
SCANMASTER_ZAP_TLS_VERIFY=true                              # optional; true|false; inherits default when omitted

# Nuclei (official signed templates; engine/template updates are disabled during scans)
SCANMASTER_NUCLEI_ENABLED=false                             # optional; true|false
SCANMASTER_NUCLEI_IMAGE=projectdiscovery/nuclei:v3.8.0@sha256:aa3a9c0894629405b5bbe644765dfffd6ff87b7663b5f1d64bcbc01341da335a # optional; immutable image
SCANMASTER_NUCLEI_TEMPLATES_DIRECTORY=.scanmaster/nuclei-templates # optional; official pinned templates directory
SCANMASTER_NUCLEI_RATE_LIMIT=50                            # optional; requests/second, 1..1000
SCANMASTER_NUCLEI_CONCURRENCY=10                           # optional; templates in parallel, 1..100
SCANMASTER_NUCLEI_TIMEOUT_SECONDS=10                       # optional; request timeout, 1..300
SCANMASTER_NUCLEI_IDENTIFICATION_HEADER=ScanMaster/0.1 authorized-security-scan # optional; User-Agent value
SCANMASTER_NUCLEI_TLS_VERIFY=true                           # optional; true|false; inherits default when omitted

# Greenbone (credentials must be supplied together; password is secret)
SCANMASTER_GREENBONE_ENABLED=false                          # optional; true|false
SCANMASTER_GREENBONE_SOCKET_PATH=/run/gvmd/gvmd.sock        # optional; Unix socket path
SCANMASTER_GREENBONE_HOST=127.0.0.1                         # optional; hostname/IP for TLS connection
SCANMASTER_GREENBONE_PORT=9390                              # optional; 1..65535
SCANMASTER_GREENBONE_USERNAME=scanmaster                    # optional; string
SCANMASTER_GREENBONE_PASSWORD=replace-with-greenbone-password # optional; secret string
SCANMASTER_GREENBONE_TLS_VERIFY=true                        # optional; true|false; inherits default when omitted

# Rapid7 InsightVM (URL, username, and password are required when enabled)
SCANMASTER_RAPID7_ENABLED=false                             # optional; true|false
SCANMASTER_RAPID7_URL=https://insightvm.example.invalid:3780 # required when enabled; HTTPS URL recommended
SCANMASTER_RAPID7_USERNAME=scanmaster                       # required when enabled; string
SCANMASTER_RAPID7_PASSWORD=replace-with-rapid7-password     # required when enabled; secret string
SCANMASTER_RAPID7_TLS_VERIFY=true                           # optional; true|false; inherits default when omitted
